PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SECRET=your_sandbox_secret
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.5-flash-lite
# BASE_URL=https://your-app.onrender.com
PAYPAL_WEBHOOK_ID=your_webhook_id_from_paypal_dashboard
# ALLOW_UNVERIFIED_WEBHOOKS=1   (local testing only, never in production)

# LLM: tries these in order. Ollama runs locally (ollama pull qwen2.5:7b), Gemini is the cloud fallback.
LLM_ORDER=ollama,gemini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: password-protect the owner dashboard (client pay pages stay public)
# DASH_PASSWORD=choose_a_password
# DB_PATH=/data/cashflow.db   (use with a persistent disk)
